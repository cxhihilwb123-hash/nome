<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="nome_database_root_title">本地数据库</string>
    <string name="nome_database_root_security_note">本地数据保留在此设备上。只有经过验证的数据库结果才能继续启动。</string>
    <string name="nome_database_root_opening_title">正在打开本地数据</string>
    <string name="nome_database_root_opening_body">正在检查加密的本地数据库；操作可能无需额外确认即可完成。</string>
    <string name="nome_database_root_migrating_title">正在更新本地数据</string>
    <string name="nome_database_root_migrating_body">正在执行已确认的数据库更新，请保持应用开启。</string>
    <string name="nome_database_root_key_title">需要数据库密钥</string>
    <string name="nome_database_root_key_body">现有密钥无法打开本地数据库。请输入你确认正确的密钥。</string>
    <string name="nome_database_root_stored_key_title">已保存的密钥不可用</string>
    <string name="nome_database_root_stored_key_body">设备无法读取用户曾提供的密钥。你可以输入已知密钥打开一次，而不覆盖原保存内容。</string>
    <string name="nome_database_root_random_key_title">生成的密钥不可用</string>
    <string name="nome_database_root_random_key_body">设备生成的数据库密钥无法恢复。该密钥从未展示，因此不提供手动输入。</string>
    <string name="nome_database_root_upgrade_title">可更新数据库</string>
    <string name="nome_database_root_upgrade_body">当前应用版本需要先更新本地数据库才能打开。</string>
    <string name="nome_database_root_downgrade_title">请求旧版数据库格式</string>
    <string name="nome_database_root_downgrade_body">使用此版本打开需要降级，并有 %1$d 条适用警告。仅应在一次性环境或已验证备份下继续。</string>
    <string name="nome_database_root_incompatible_title">数据库版本不兼容</string>
    <string name="nome_database_root_incompatible_body">应用无法安全变更当前数据库版本，此处不声称可在应用内恢复。</string>
    <string name="nome_database_root_failed_title">无法打开本地数据库</string>
    <string name="nome_database_root_failed_body">本地数据库操作失败；本页面不会显示技术错误载荷。</string>
    <string name="nome_database_root_keystore_title">安全密钥存储不可用</string>
    <string name="nome_database_root_keystore_body">当前数据库操作无法使用 Android 安全存储。</string>
    <string name="nome_database_root_confirmation_title">未接受确认</string>
    <string name="nome_database_root_confirmation_body">数据库操作已停止，已确认的迁移选择没有被改写。</string>
    <string name="nome_database_root_unknown_title">数据库状态不可用</string>
    <string name="nome_database_root_unknown_body">数据库返回了不受支持的结果；不会显示原始诊断数据。</string>
    <string name="nome_database_root_restored_title">已复制匹配的本地文件对</string>
    <string name="nome_database_root_restored_body">两个匹配的加密前文件均已复制，但数据库尚未打开。</string>
    <string name="nome_database_root_backup_failed_title">未复制匹配的本地文件对</string>
    <string name="nome_database_root_backup_failed_body">受限本地复制未完成，数据库结果没有改变。</string>
    <string name="nome_database_root_passphrase_label">数据库口令</string>
    <string name="nome_database_root_passphrase_private">只有选择“保存并打开”时才会保存口令。</string>
    <string name="nome_database_root_open_once">仅打开一次</string>
    <string name="nome_database_root_save_and_open">保存并打开</string>
    <string name="nome_database_root_upgrade_action">更新并打开</string>
    <string name="nome_database_root_downgrade_action">降级并打开</string>
    <string name="nome_database_root_open_restored">打开已恢复的本地数据库</string>
    <string name="nome_database_root_copy_backup">复制匹配的本地备份文件对</string>
    <string name="nome_database_root_backup_limit">此受限恢复只替换时间戳精确匹配的聊天和代理数据库文件对。复制成功不代表数据库可以打开。</string>
    <string name="nome_database_root_backup_confirm_title">复制匹配的本地文件对？</string>
    <string name="nome_database_root_backup_confirm_body">两个当前本地数据库文件将由精确匹配的加密前副本替换；打开数据库仍是独立步骤。</string>
    <string name="nome_database_root_backup_confirm">复制文件对</string>
    <string name="nome_database_root_not_now">暂不</string>
    <string name="nome_database_root_submitting">操作进行中</string>
    <string name="nome_database_root_waiting">等待你的操作</string>
</resources>
